# Paribesh Bandhu Jury Portal — Hostinger (Apache/LiteSpeed)
Options -Indexes
DirectoryIndex index.html

# Force HTTPS (required for install-as-app / service worker)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Correct types
AddType application/manifest+json .webmanifest
AddType application/javascript .js

# Always fetch latest app code; cache icons
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|config\.js|app\.js|index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|css)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
